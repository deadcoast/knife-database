{
  "database_name": "folding_knife_research_database",
  "jurisdiction": "Canada",
  "version": "0.2.0",
  "definitions": {
    "approved": "A knife the user currently considers worthy of further research into acquisition. This is not a final purchase decision.",
    "rejected": "A knife the user considers banned, unworthy, or not worth further research into purchase.",
    "clean": "A knife that is more than beautiful while utilizing minimal aesthetics.",
    "fancy": "A unique blade style not often seen, e.g. Spyderco Matriarch 2 Emerson.",
    "tiered": "An enthusiast knife in the high-tier quality range of, or above, a Chris Reeve."
  },
  "id_rule": {
    "format": "brand-model-key-variant",
    "style": "lowercase-kebab-case",
    "example": "spyderco-matriarch-2-emerson-open-c12sbk2w"
  },
  "workflow_rules": {
    "canadian_online_retailer_rule": {
      "rule": "If a folding knife is listed by a Canadian online retailer, treat it as valid for Canadian acquisition research unless the listing itself clearly identifies a prohibited mechanism.",
      "status_to_use": "canadian_retailer_verified",
      "do_not_flag_as_conditional_just_because": [
        "assisted opening",
        "manual flipper",
        "wave opener",
        "Emerson opener",
        "axis lock",
        "crossbar lock",
        "shark lock",
        "button lock used only as a lock",
        "ceramic bearings",
        "one-hand opening",
        "thumb stud",
        "thumb hole",
        "front flipper"
      ],
      "only_reject_or_fail_if_clear_prohibited_mechanism": [
        "automatic switchblade",
        "OTF automatic",
        "gravity knife",
        "balisong",
        "butterfly knife",
        "explicit centrifugal/flick knife",
        "button/spring/device in handle that automatically opens the blade"
      ]
    }
  },
  "canada_prohibited_carry_screen": {
    "prohibited_mechanisms": {
      "gravity_opening": true,
      "centrifugal_or_wrist_flick_opening": true,
      "button_spring_or_handle_device_auto_opening": true,
      "balisong_or_butterfly": true
    },
    "allowed_or_not_automatically_disqualifying": {
      "assisted_opening_when_sold_by_canadian_retailer": true,
      "manual_flipper_when_sold_by_canadian_retailer": true,
      "wave_or_emerson_opener_when_sold_by_canadian_retailer": true,
      "axis_crossbar_shark_or_similar_locks_when_sold_by_canadian_retailer": true,
      "button_lock_when_button_is_lock_not_auto_opener": true
    }
  },
