/* RESEARCH — door 5's own stylesheet (Screen.CSS_PATH).
   The desk under the unknowns map: docket, READ, STAMP. */

ResearchScreen {
    layers: base plate capsule door;
}

/* the map is a titled pane: the title rides the border, the completeness
   count rides the subtitle edge; +2 rows for the border itself */
#desk-map {
    height: 11;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
}

#desk-line {
    height: 1fr;
    padding: 1 2;
}

/* the transit tray — a channel cut INTO the floor; the plate rides it */
#desk-tray {
    height: 13;
    margin: 0 3 0 3;
    background: $surface-low;
    border-top: round $bevel-shadow;
    border-left: round $bevel-shadow;
    border-bottom: round $bevel-light;
    border-right: round $bevel-light;
    border-title-color: $steel-dim;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 0 1;
}

#desk-plate {
    layer: plate;
    offset: 4 26;
    padding: 0 2;
    /* an empty plate is not hardware — it appears when it carries a record */
    display: none;
}

#desk-plate.carrying {
    display: block;
}

/* CUE — the card file answers the hand: a tab under the pointer (or lit
   from the map) lifts, and its column on the map lights in return */

.docket-card {
    height: auto;
    transition: background $cue-duration $cue-easing;
}

.docket-card:hover {
    background: $surface-high;
}

.docket-card.spotlit {
    background: $surface-high;
}

.docket-card.working {
    background: $surface-low;
}
