/* MARKET PRICES — door 4's own stylesheet (Screen.CSS_PATH).
   The drawn instruments over the real distribution: the valuation
   column full height on the left, the $150 line stacked over the
   survey station on the right. */

MarketScreen {
    layers: base capsule door;
}

#ledger {
    height: 1fr;
    padding: 1 2;
}

#ledger-valuation {
    width: 5fr;
}

#ledger-right {
    width: 7fr;
    height: 100%;
}

#ledger-line {
    height: 1fr;
    margin: 0 1 1 1;
}

#ledger-movers {
    height: 1fr;
    margin: 0 1;
}
