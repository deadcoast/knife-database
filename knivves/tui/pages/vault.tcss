/* THE VAULT — page 0, the entry hall's own stylesheet (Screen.CSS_PATH).
   Three plaques under the masthead: state, doors, next acquisitions.
   Every color is a $variable of the `knivves` theme (laws.py). */

VaultScreen {
    layers: base capsule door;
}

#hall {
    height: 1fr;
    padding: 1 2;
}

.hall-fixture {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    border: round $edge;
    padding: 1 2;
    overflow: hidden hidden;
}

#hall-doors {
    width: 2fr;
}

.hall-fixture-name {
    color: $steel-mid;
    text-style: bold;
    border-bottom: solid $edge;
    padding-bottom: 1;
}

.hall-fixture-body {
    margin-top: 1;
}
