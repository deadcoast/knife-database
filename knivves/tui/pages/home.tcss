/* HOME — page 0, the entry hall's own stylesheet (Screen.CSS_PATH).
   The showpiece: the brand plaque in brushed steel over three full-height
   instrument columns. Every color is a $variable of the `knivves` theme
   (laws.py). Panels are raised machined surfaces — lit top/left edge,
   thrown bottom/right shadow — never outlines on void. */

HomeScreen {
    layers: base capsule door;
}

#hall-brand {
    margin: 0 0 1 0;
}

#hall {
    height: 1fr;
    padding: 0 2;
}

/* raised panels — the surface sits proud of the floor */
.hall-fixture {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border-top: round $bevel-light;
    border-left: round $bevel-light;
    border-bottom: round $bevel-shadow;
    border-right: round $bevel-shadow;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 2;
    overflow: hidden hidden;
    transition: background $cue-duration $cue-easing, opacity 350ms $cue-easing, offset 350ms $cue-easing;
}

/* REVEAL — the panes physically rise into place as they surface */
.hall-fixture.cold {
    offset: 0 2;
}

/* CUE — the pane under the hand lifts; children lift with it */
.hall-fixture:hover {
    background: $surface-high;
}

.hall-fixture:hover > .hall-fixture-body {
    background: $surface-high;
}

#hall-doors {
    width: 2fr;
}

.hall-fixture-body {
    margin-top: 1;
    height: auto;
}

/* REVEAL — the plaques surface one by one behind the parting door */
.hall-fixture * {
    transition: opacity 350ms $cue-easing;
}

.hall-fixture.cold,
.hall-fixture.cold * {
    opacity: 0%;
}

/* CUE — a page slab under the hand lifts; the click is the key.
   Each slab is a recessed key seated in the panel, its own left spine. */
/* the keypad fills its column: the BODY is height-defined (1fr of the
   fixture), so fr slabs are safe — they share real space, never balloon
   (the 013 trap only bites inside auto-height parents) */
#hall-doors-body {
    height: 1fr;
}

.door-row {
    height: 1fr;
    min-height: 3;
    padding: 0 2;
    margin-bottom: 1;
    background: $surface-low;
    border-left: thick $edge;
    transition: background $cue-duration $cue-easing, opacity 350ms $cue-easing;
}

.door-row:hover {
    background: $surface-raised;
    border-left: thick $accent;
}
