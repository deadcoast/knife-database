/* THE VAULT — page 0, the entry hall's own stylesheet (Screen.CSS_PATH).
   The showpiece: the brand plate in brushed steel, three machined
   plaques over the collection drawn across the floor. Every color is a
   $variable of the `knivves` theme (laws.py). */

HomeScreen {
    layers: base capsule door;
}

#hall-brand {
    margin: 0 0 1 0;
}

#hall {
    height: 1fr;
    padding: 0 2;
}

/* titled panes — the title rides the border, no bar behind it */
.hall-fixture {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 2;
    overflow: hidden hidden;
    transition: background $cue-duration $cue-easing, opacity 350ms $cue-easing;
}

/* CUE — the pane under the hand lifts; children lift with it */
.hall-fixture:hover {
    background: $surface-high;
}

.hall-fixture:hover > .hall-fixture-body {
    background: $surface-high;
}

#hall-doors {
    width: 2fr;
}

.hall-fixture-body {
    margin-top: 1;
}

/* the whole collection, drawn across the floor as a titled pane */
#hall-map {
    height: 12;
    margin: 0 2;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
}

/* REVEAL — the plaques surface one by one behind the parting door */
.hall-fixture * {
    transition: opacity 350ms $cue-easing;
}

.hall-fixture.cold,
.hall-fixture.cold * {
    opacity: 0%;
}

/* CUE — a door slab under the hand lifts; the click is the key */
.door-row {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-low;
    transition: background $cue-duration $cue-easing, opacity 350ms $cue-easing;
}

.door-row:hover {
    background: $surface-raised;
}

