/* IMPORT KNIVES — door 2's own stylesheet (Screen.CSS_PATH).
   The intake line: paste a URL or an ingestion .md, the stations run. */

ImportsScreen {
    layers: base plate capsule door;
}

#forge-intake {
    height: 3;
    background: $background;
    border: tall $edge;
    color: $steel-body;
    padding: 0 1;
    transition: background $cue-duration $cue-easing;
}

/* CUE — the intake slot lights under the hand */
#forge-intake:hover {
    background: $surface-low;
}

#forge-intake:focus {
    border: tall $accent;
    background: $surface-low;
}

#forge-line {
    height: 1fr;
    padding: 1 2;
}

/* the transit tray — a channel cut INTO the floor: shadow on the lit
   edges, light where the cut catches the room. The plate rides it. */
#forge-tray {
    height: 14;
    margin: 0 3 0 3;
    background: $surface-low;
    border-top: round $bevel-shadow;
    border-left: round $bevel-shadow;
    border-bottom: round $bevel-light;
    border-right: round $bevel-light;
    border-title-color: $steel-dim;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 0 1;
}

/* REVEAL — the line lights station by station */
ImportsScreen .station,
ImportsScreen .station * {
    transition: opacity 350ms $cue-easing;
}

ImportsScreen .station.cold,
ImportsScreen .station.cold * {
    opacity: 0%;
}

#forge-plate {
    layer: plate;
    offset: 4 26;
    padding: 0 2;
    /* an empty plate is not hardware — it appears when it carries a record */
    display: none;
}

#forge-plate.carrying {
    display: block;
}
