/* COMPARE MODELS — door 3's own stylesheet (Screen.CSS_PATH).
   Two plates over the room's namesake: the caliper bed spans the full
   width, beams riding rails the length of the bench. The bench band is
   one machined row — plates and panel cut to the same height. */

CompareScreen {
    layers: base capsule door;
}

#bench {
    height: 1fr;
    min-height: 16;
    padding: 1 2 0 2;
    align-horizontal: center;
}

.bench-plate {
    height: 100%;
    margin: 0 1;
}

/* the summary pane — a raised panel between the two plates */
#calipers {
    width: 40;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border-top: round $bevel-light;
    border-left: round $bevel-light;
    border-bottom: round $bevel-shadow;
    border-right: round $bevel-shadow;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
}

/* the measurement bed — full width, the beams seated at its center */
#calipers-bed {
    height: 17;
    margin: 1 3 0 3;
    background: $surface;
    border-top: round $bevel-light;
    border-left: round $bevel-light;
    border-bottom: round $bevel-shadow;
    border-right: round $bevel-shadow;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 3;
    align: center middle;
}

/* REVEAL — the instrument warms; plates arrive under the motion law */
#calipers,
#calipers *,
#calipers-bed,
#calipers-bed * {
    transition: opacity 350ms $cue-easing;
}

#calipers.cold,
#calipers.cold *,
#calipers-bed.cold,
#calipers-bed.cold * {
    opacity: 0%;
}
