/* COMPARE MODELS — door 3's own stylesheet (Screen.CSS_PATH).
   Two plates over the room's namesake: the caliper bed spans the full
   width, beams riding rails the length of the bench. */

CompareScreen {
    layers: base capsule door;
}

#bench {
    height: auto;
    padding: 1 2;
    align-horizontal: center;
}

.bench-plate {
    margin: 0 1;
}

/* the summary pane — a titled pane between the two knives */
#calipers {
    width: 40;
    height: auto;
    min-height: 14;
    margin: 0 1;
    background: $surface;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
}

/* the measurement pane — full width, beams seated at its center */
#calipers-bed {
    height: 1fr;
    margin: 0 3 1 3;
    background: $surface;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 3;
    align: center middle;
}

/* REVEAL — the instrument warms; plates arrive under the motion law */
#calipers,
#calipers *,
#calipers-bed,
#calipers-bed * {
    transition: opacity 350ms $cue-easing;
}

#calipers.cold,
#calipers.cold *,
#calipers-bed.cold,
#calipers-bed.cold * {
    opacity: 0%;
}
