/* KNIVVES — the building's chrome, App-level.
   Only what every page shares lives here: the Screen base, the Footer,
   the engraved station frames. Each page's own layout rides beside its
   module as pages/<page>.tcss (Screen.CSS_PATH). Every color is a
   $variable of the `knivves` theme — laws.py is the single source of
   truth and no stylesheet in the building may carry a raw color. */

Screen {
    background: $background;
    color: $steel-body;
    overflow: hidden hidden;
}

Footer {
    background: $surface;
    color: $steel-dim;
}

/* machined station panels — shared by the intake line and the desk.
   A station is a raised plate, not an outline on void: surface metal
   for the body, the top/left edges catching the light, the bottom/right
   falling into shadow. */

.station {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border-top: solid $edge-bright;
    border-left: solid $edge-bright;
    border-bottom: solid $background;
    border-right: solid $background;
    padding: 1 2;
    overflow: hidden hidden;
}

.station-name {
    color: $steel-mid;
    text-style: bold;
    border-bottom: solid $edge;
    padding-bottom: 1;
}

.station-body {
    margin-top: 1;
    color: $steel-mid;
}
