/* KNIVVES — the building's chrome, App-level.
   Only what every page shares lives here: the Screen base, the Footer,
   the engraved station frames. Each page's own layout rides beside its
   module as pages/<page>.tcss (Screen.CSS_PATH). Every color is a
   $variable of the `knivves` theme — laws.py is the single source of
   truth and no stylesheet in the building may carry a raw color. */

Screen {
    background: $background;
    color: $steel-body;
    overflow: hidden hidden;
}

Footer {
    background: $surface;
    color: $steel-dim;
}

/* station panes — raised machined panels, not outlines on void: the
   surface sits proud of the floor, its top and left edges catch the
   light, its bottom and right edges throw shadow. The title rides IN
   the top edge; counts ride the subtitle edge. */

.station {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border-top: round $bevel-light;
    border-left: round $bevel-light;
    border-bottom: round $bevel-shadow;
    border-right: round $bevel-shadow;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 2;
    overflow: hidden hidden;
}

.station-body {
    margin-top: 1;
    color: $steel-mid;
}
