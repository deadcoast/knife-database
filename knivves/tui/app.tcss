/* KNIVVES — the building's chrome, App-level.
   Only what every page shares lives here: the Screen base, the Footer,
   the engraved station frames. Each page's own layout rides beside its
   module as pages/<page>.tcss (Screen.CSS_PATH). Every color is a
   $variable of the `knivves` theme — laws.py is the single source of
   truth and no stylesheet in the building may carry a raw color. */

Screen {
    background: $background;
    color: $steel-body;
    overflow: hidden hidden;
}

Footer {
    background: $surface;
    color: $steel-dim;
}

/* station panes — titled borders, the native Textual pane language:
   the title rides IN the border line, no bar behind it, and the border
   itself carries the structure. Counts ride the subtitle edge. */

.station {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    background: $surface;
    border: round $edge-bright;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $steel-dim;
    padding: 1 2;
    overflow: hidden hidden;
}

.station-body {
    margin-top: 1;
    color: $steel-mid;
}
